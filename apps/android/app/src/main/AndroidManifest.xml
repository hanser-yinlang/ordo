<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      v1.4（纯本地）：应用**不联网**，因此没有 INTERNET / ACCESS_NETWORK_STATE 权限。
      依据：全部网络客户端（Ktor/OkHttp/WebSocket）、同步调度器、实时通道、会话与令牌都已删除，
      代码里不存在任何 socket / HTTP 调用（见 README「纯本地证明」），
      移除 INTERNET 后即使未来误引入网络调用，系统也会直接抛 SecurityException。
    -->
    <!-- 本地提醒到点通知 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 开机后重排提醒（WorkManager，纯本地） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".OrdoApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ordo">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|fontScale"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Ordo">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 深链：ordo://list/today、ordo://todo/{id}、ordo://project/{id} -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ordo" />
            </intent-filter>
        </activity>

    </application>

</manifest>
