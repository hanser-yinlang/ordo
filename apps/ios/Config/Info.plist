<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Ordo · iOS 应用配置

  说明:
  · CFBundleURLTypes 注册 `ordo` scheme(设计规范 §7:Universal Links + ordo://);
    Universal Links 的域名声明在 Config/Ordo.entitlements 的 associated-domains 中。
  · NSAppTransportSecurity 仅为本地开发开放 127.0.0.1 的明文 HTTP(TS 后端默认端口 8787);
    生产环境必须走 HTTPS/WSS(契约 §9)。
  · OrdoNotificationPermissionExplanation 是自定义说明键(系统不读取),
    供设置页展示,内容与 Notifications/ReminderScheduler.permissionExplanation 保持一致。
  · NSCalendarsFullAccessUsageDescription:契约 §2.8 的只读日历(「今天」清单顶部日程区块)。
    应用**只读**系统日历,不写入、不上传;权限被拒时静默回退示例日程(见 Data/EventKitAgenda.swift)。
    两个键都保留:NSCalendarsFullAccessUsageDescription 供 iOS 17+ 的
    `requestFullAccessToEvents()`,NSCalendarsUsageDescription 供 iOS 16 回退路径
    `requestAccess(to: .event)`。
  · UILaunchScreen 为空字典:使用系统默认启动画面,避免旧式启动图导致的黑边。
-->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh_CN</string>
	<key>CFBundleDisplayName</key>
	<string>序 Ordo</string>
	<key>CFBundleName</key>
	<string>Ordo</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>zh-Hans</string>
		<string>en</string>
	</array>

	<!-- 深链:ordo://today、ordo://todo/<id>、ordo://project/<id>、ordo://tag/<名> … -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.ordo.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>ordo</string>
			</array>
		</dict>
	</array>

	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- 本地开发:允许访问 127.0.0.1 的明文 HTTP(生产强制 HTTPS/WSS,契约 §9) -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSExceptionDomains</key>
		<dict>
			<key>127.0.0.1</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSIncludesSubdomains</key>
				<false/>
			</dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>

	<!-- 通知权限说明(自定义键,系统不读取;设置页会展示同样的文案) -->
	<key>OrdoNotificationPermissionExplanation</key>
	<string>开启通知后,Ordo 会在你设定的提醒时刻提醒你;提醒时间来自每一条待办的「提醒」字段,数据只保存在本机。</string>

	<!-- 日历权限(iOS 17+):只读,用于「今天」清单顶部的日程区块(契约 §2.8) -->
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Ordo 只读取系统日历中的日程,用于在「今天」清单顶部显示今日安排;日历内容只留在本机,不会上传。</string>

	<!-- 日历权限(iOS 16 回退路径 requestAccess(to: .event) 使用) -->
	<key>NSCalendarsUsageDescription</key>
	<string>Ordo 只读取系统日历中的日程,用于在「今天」清单顶部显示今日安排;日历内容只留在本机,不会上传。</string>

	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
</dict>
</plist>
