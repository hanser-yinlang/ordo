# Ordo 后端环境变量示例:复制为 .env 后按需修改
# 注意:生产环境必须显式设置 JWT_SECRET,否则拒绝启动(契约 §9)

# ---- 运行 ----
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# ---- 存储(留空或连不上 → 自动降级为内存仓储,仅适合开发/测试)----
DATABASE_URL=postgres://ordo:secret@127.0.0.1:5432/ordo
DB_POOL_MAX=10

# ---- 令牌(契约 §9)----
JWT_SECRET=please-change-me-to-a-32-byte-random-string
ACCESS_TTL_SEC=1800
REFRESH_TTL_DAYS=30

# ---- 时间与 Fastlane(契约 §7.5)----
TZ_OFFSET_MINUTES=480
REMINDER_SCAN_MS=1000
REMINDER_HORIZON_MS=60000

# ---- 限制(契约 §7.4)----
BODY_LIMIT_BYTES=524288
MAX_OPS_PER_PUSH=500
MAX_OP_PAYLOAD_BYTES=262144
MAX_PULL_LIMIT=1000
DEFAULT_PULL_LIMIT=200
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CAPACITY=10
RATE_LIMIT_REFILL_PER_SEC=10

# ---- 墓碑清理定时任务(契约 §3:删除墓碑保留 30 天)----
# 周期,<=0 表示关闭定时任务;默认 300000(5 分钟)
TOMBSTONE_PURGE_INTERVAL_MS=300000
# 墓碑保留时长;默认 2592000000(30 天)
TOMBSTONE_TTL_MS=2592000000

# ---- 行为开关 ----
# 服务端是否代生成重复待办的下一次实例(默认 false:本地优先,由客户端生成,避免双写)
SERVER_SIDE_REPEAT=false
