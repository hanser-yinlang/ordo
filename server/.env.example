# Ordo 后端环境变量示例:复制为 .env 后按需修改
# 注意:生产环境必须显式设置 JWT_SECRET,否则拒绝启动(契约 §9)

# ---- 运行 ----
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# ---- 存储(留空或连不上 → 自动降级为内存仓储,仅适合开发/测试)----
DATABASE_URL=postgres://ordo:secret@127.0.0.1:5432/ordo
DB_POOL_MAX=10

# ---- 令牌(契约 §9)----
JWT_SECRET=please-change-me-to-a-32-byte-random-string
ACCESS_TTL_SEC=1800
REFRESH_TTL_DAYS=30

# ---- 邮箱验证码登录(契约 §7.6.5,迁移 004)----
# 验证码:6 位数字、默认 300 秒有效、一次性消费、同码最多试 5 次
ORDO_EMAIL_CODE_TTL_SEC=300
# 同一邮箱再次请求的最小间隔(秒),客户端据此跑倒计时
ORDO_EMAIL_CODE_RETRY_AFTER_SEC=60
# 同一邮箱每小时 / 每天最多发几条(超出返回 429 code_throttled)
ORDO_EMAIL_CODE_MAX_PER_HOUR=5
ORDO_EMAIL_CODE_MAX_PER_DAY=10
# 同码最多尝试次数,达到即作废(必须重新获取)
ORDO_EMAIL_CODE_MAX_ATTEMPTS=5
# 验证码哈希 pepper:HMAC-SHA256(pepper, email + ':' + code)。
# **生产必填**(缺了拒绝启动);开发/测试留空则回退 JWT_SECRET(契约 §7.6.5 / §9)
ORDO_CODE_PEPPER=
# 开发回显:仅当 NODE_ENV != production 且发信通道为 console 时,响应额外带 devCode。
# NODE_ENV=production 时把它设为 1 会**拒绝启动**(契约 §7.6.5)
ORDO_DEV_ECHO_CODE=0

# ---- 发信通道(契约 §7.6.5)----
# console(默认):把邮件写进服务端日志,适合本地开发/测试;
#                    生产环境用 console 不会真的投递,且日志里不打印验证码(契约 §9)
# http:POST {to,subject,text} 到通用邮件网关(带 Authorization: Bearer <token>)
ORDO_MAIL_TRANSPORT=console
# transport=http 时**必填**(缺了拒绝启动)
ORDO_MAIL_HTTP_URL=
# 网关鉴权 token(可留空)
ORDO_MAIL_HTTP_TOKEN=
# 发信请求超时(毫秒);超时按发信失败处理(500 code=INTERNAL, details.reason=mail_failed)
ORDO_MAIL_HTTP_TIMEOUT_MS=5000

# ---- 时间与 Fastlane(契约 §7.5)----
TZ_OFFSET_MINUTES=480
REMINDER_SCAN_MS=1000
REMINDER_HORIZON_MS=60000

# ---- 限制(契约 §7.4)----
BODY_LIMIT_BYTES=524288
MAX_OPS_PER_PUSH=500
MAX_OP_PAYLOAD_BYTES=262144
MAX_PULL_LIMIT=1000
DEFAULT_PULL_LIMIT=200
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CAPACITY=10
RATE_LIMIT_REFILL_PER_SEC=10

# ---- 墓碑清理定时任务(契约 §3:删除墓碑保留 30 天)----
# 周期,<=0 表示关闭定时任务;默认 300000(5 分钟)
TOMBSTONE_PURGE_INTERVAL_MS=300000
# 墓碑保留时长;默认 2592000000(30 天)
TOMBSTONE_TTL_MS=2592000000

# ---- 行为开关 ----
# 服务端是否代生成重复待办的下一次实例(默认 false:本地优先,由客户端生成,避免双写)
SERVER_SIDE_REPEAT=false
