{
  "name": "ordo-server",
  "version": "1.0.0",
  "private": true,
  "description": "Ordo(序)后端:数据模型 / 同步协议 / Fastlane 提醒 / 实时通道 —— 契约 03 v1 参考实现",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/scripts/migrate.ts",
    "migrate:prod": "node dist/scripts/migrate.js"
  },
  "dependencies": {
    "@fastify/websocket": "^11.0.1",
    "fastify": "^5.2.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "optionalDependencies": {
    "argon2": "^0.41.1"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "pg-mem": "^3.0.14",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "ws": "^8.18.0"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild",
      "argon2"
    ]
  }
}
